# Server
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
NODE_ENV=development

# SQLite
SQLITE_PATH=./data/bus.db

# OTP (demo mode — logs OTP to console instead of sending SMS)
OTP_DEMO_MODE=true
# Plug a real SMS gateway later (e.g. MSG91, Twilio) here:
SMS_API_KEY=
SMS_SENDER_ID=

# Google Maps
GOOGLE_MAPS_API_KEY=your_google_maps_key

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Redis (Upstash) - used for seat locking + live location cache
REDIS_URL=rediss://default:password@your-upstash-endpoint:6379

# API Setu Sandbox (PAN/Aadhaar verification demo)
# Real sandbox access requires registering as a government API consumer —
# a multi-step approval process, not instant signup. For testing without
# that, leave APISETU_MOCK_MODE=true: it simulates verification using basic
# format checks (no real network call), so you can test the full driver KYC
# flow end-to-end. Set to false once you have real credentials below.
APISETU_MOCK_MODE=true
APISETU_BASE_URL=https://apisetu.gov.in/sandbox
APISETU_CLIENT_ID=your_client_id
APISETU_CLIENT_SECRET=your_client_secret

# Backblaze B2 (for storing KYC images: PAN/Aadhaar/driver photo)
B2_KEY_ID=your_b2_key_id
B2_APP_KEY=your_b2_app_key
B2_BUCKET_NAME=bus-booking-kyc
B2_BUCKET_ID=your_bucket_id

# Master key to create the very first official/admin account
SUPER_ADMIN_SETUP_KEY=super_secret_first_setup_key
